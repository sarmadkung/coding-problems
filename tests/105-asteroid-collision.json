{
  "fn": "asteroidCollision",
  "compare": "exact",
  "cases": [
    { "in": [[5, 10, -5]], "out": [5, 10] },
    { "in": [[8, -8]], "out": [] },
    { "in": [[10, 2, -5]], "out": [10] },
    { "in": [[-2, -1, 1, 2]], "out": [-2, -1, 1, 2] },
    { "in": [[1, 2, 3, -10]], "out": [-10] },
    { "in": [[-5, 5]], "out": [-5, 5] },
    { "in": [[3, 5, -5, -1]], "out": [3] },
    { "in": [[1000, -999, -1000, -1]], "out": [-1] }
  ]
}
