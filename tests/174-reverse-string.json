{
  "fn": "reverseString",
  "compare": "exact",
  "result": "arg0",
  "cases": [
    { "in": [["h", "e", "l", "l", "o"]], "out": ["o", "l", "l", "e", "h"] },
    { "in": [["H", "a", "n", "n", "a", "h"]], "out": ["h", "a", "n", "n", "a", "H"] },
    { "in": [["x"]], "out": ["x"] },
    { "in": [["a", "b"]], "out": ["b", "a"] },
    { "in": [["1", " ", "!", "?"]], "out": ["?", "!", " ", "1"] },
    { "in": [["r", "a", "c", "e", "c", "a", "r"]], "out": ["r", "a", "c", "e", "c", "a", "r"] }
  ]
}
