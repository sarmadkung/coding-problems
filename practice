#!/usr/bin/env node
/**
 * practice — run your solutions against the test cases for each problem.
 *
 *   ./practice c 001    run one problem
 *   ./practice c 01     run every problem in a topic folder
 *   ./practice c        run everything you have attempted
 *   ./practice c --all  include problems you have not started
 *
 *   ./practice list             show all problems and their state
 *   ./practice list --easy      filter by difficulty (--easy/--medium/--hard)
 *   ./practice list --todo      only problems not yet attempted
 *   ./practice status           one-line progress summary
 *   ./practice stats            full analytics: difficulty, topic, capability
 *   ./practice readme           regenerate the README analytics + index files
 *
 * Exit code is 0 when nothing failed, 1 otherwise — so CI can call it.
 */

'use strict';

const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const ROOT = __dirname;
const PROBLEMS = path.join(ROOT, 'problems');
const STRUCT = require('./problems/_lib/structures');
const TESTS = path.join(ROOT, 'tests');
const STUB = '// TODO: your solution here';

// ---------------------------------------------------------------- colour
const useColour = process.stdout.isTTY && !process.env.NO_COLOR;
const c = (code) => (s) => (useColour ? `[${code}m${s}[0m` : String(s));
const dim = c('2');
const bold = c('1');
const green = c('32');
const red = c('31');
const yellow = c('33');
const cyan = c('36');

// ---------------------------------------------------------------- discovery
function listProblems() {
  const out = [];
  for (const folder of fs.readdirSync(PROBLEMS).sort()) {
    if (folder.startsWith('_')) continue; // shared helpers, not problems
    const dir = path.join(PROBLEMS, folder);
    if (!fs.statSync(dir).isDirectory()) continue;
    for (const file of fs.readdirSync(dir).sort()) {
      if (!file.endsWith('.js')) continue;
      const full = path.join(dir, file);
      const src = fs.readFileSync(full, 'utf8');
      const head = src.split('\n', 3);
      const m1 = /^ \* (\d+) — (.+)$/.exec(head[1] || '');
      const m2 = /^ \* Difficulty: (\w+)\s+·\s+Topic: (.+)$/.exec(head[2] || '');
      if (!m1) continue;
      out.push({
        id: m1[1],
        num: parseInt(m1[1], 10),
        title: m1[2].trim(),
        difficulty: m2 ? m2[1] : '?',
        topic: m2 ? m2[2].trim() : '?',
        folder,
        file: full,
        rel: path.relative(ROOT, full),
        attempted: !src.includes(STUB),
      });
    }
  }
  return out.sort((a, b) => a.num - b.num);
}

function loadTest(id) {
  if (!fs.existsSync(TESTS)) return null;
  const hit = fs.readdirSync(TESTS).find((f) => f.startsWith(id + '-') && f.endsWith('.json'));
  if (!hit) return null;
  return JSON.parse(fs.readFileSync(path.join(TESTS, hit), 'utf8'));
}

/**
 * Node-shaped inputs and outputs.
 *
 * A test case is plain JSON, but a tree or linked-list problem must receive a
 * real node object — that is what the platforms hand you. A spec declares the
 * shape per argument with `inTypes`, and for the return value with `outType`:
 *
 *   { "fn": "maxDepth", "inTypes": ["tree"], "cases": [...] }
 *   { "fn": "reverseList", "inTypes": ["list"], "outType": "list", ... }
 *
 * Types: "tree" level-order array, "list" value array, "cycleList" [values, pos],
 *        "node" a single node compared by its `val`, null/absent passes through.
 */
function hydrate(value, type) {
  switch (type) {
    case 'tree':
      return STRUCT.buildTree(value);
    case 'list':
      return STRUCT.buildList(value);
    case 'cycleList':
      return STRUCT.buildCycleList(value[0], value[1]);
    default:
      return value;
  }
}

function dehydrate(value, type) {
  switch (type) {
    case 'tree':
      return STRUCT.treeToArray(value);
    case 'list':
      return STRUCT.listToArray(value);
    case 'node':
      return value === null || value === undefined ? null : value.val;
    default:
      return value;
  }
}

// ---------------------------------------------------------------- comparison
function deepEqual(a, b) {
  if (a === b) return true;
  if (typeof a === 'number' && typeof b === 'number') {
    return a === b || (Number.isNaN(a) && Number.isNaN(b));
  }
  if (Array.isArray(a) && Array.isArray(b)) {
    return a.length === b.length && a.every((x, i) => deepEqual(x, b[i]));
  }
  if (a && b && typeof a === 'object' && typeof b === 'object') {
    const ka = Object.keys(a).sort();
    const kb = Object.keys(b).sort();
    return deepEqual(ka, kb) && ka.every((k) => deepEqual(a[k], b[k]));
  }
  return false;
}

const byJson = (x, y) => (JSON.stringify(x) < JSON.stringify(y) ? -1 : 1);

/**
 * Comparison modes, so a correct answer in a different order still passes:
 *   exact       strict deep equality (the default)
 *   unordered   top-level array order does not matter    (topKFrequent)
 *   setOfSets   neither outer nor inner order matters     (groupAnagrams, threeSum)
 *   approx      floating point within 1e-6                (medians, averages)
 */
function matches(actual, expected, mode) {
  switch (mode) {
    case 'unordered':
      if (!Array.isArray(actual) || !Array.isArray(expected)) return false;
      return deepEqual([...actual].sort(byJson), [...expected].sort(byJson));
    case 'setOfSets': {
      if (!Array.isArray(actual) || !Array.isArray(expected)) return false;
      const norm = (g) => g.map((x) => (Array.isArray(x) ? [...x].sort(byJson) : x)).sort(byJson);
      return deepEqual(norm(actual), norm(expected));
    }
    case 'approx':
      return typeof actual === 'number' && Math.abs(actual - expected) < 1e-6;
    default:
      return deepEqual(actual, expected);
  }
}

// ---------------------------------------------------------------- display
function show(v, max = 44) {
  let s;
  try {
    s = JSON.stringify(v);
  } catch {
    s = String(v);
  }
  if (s === undefined) s = 'undefined';
  return s.length > max ? s.slice(0, max - 1) + '…' : s;
}

const callLabel = (fn, args) => `${fn}(${args.map((a) => show(a, 20)).join(', ')})`;

// ---------------------------------------------------------------- running
function runCases(problem, spec) {
  const results = [];
  let mod;
  try {
    mod = require(problem.file);
  } catch (err) {
    return [{ ok: false, label: 'loading the file', error: err.message }];
  }

  // Class-based problems: drive a sequence of operations.
  if (spec.type === 'class') {
    const Cls = mod[spec.cls];
    if (typeof Cls !== 'function') {
      return [{ ok: false, label: spec.cls, error: `${spec.cls} is not exported` }];
    }
    for (const tc of spec.cases) {
      try {
        const inst = new Cls(...(tc.ctor || []));
        const got = tc.ops.map((op, i) => {
          const r = inst[op](...(tc.args[i] || []));
          return r === undefined ? null : r;
        });
        const ok = matches(got, tc.out, spec.compare);
        results.push({ ok, label: tc.ops.join(' → '), actual: got, expected: tc.out });
      } catch (err) {
        results.push({ ok: false, label: tc.ops.join(' → '), error: err.message });
      }
    }
    return results;
  }

  const fn = mod[spec.fn];
  if (typeof fn !== 'function') {
    return [{ ok: false, label: spec.fn, error: `${spec.fn} is not exported from the file` }];
  }

  const inTypes = spec.inTypes || [];
  for (const tc of spec.cases) {
    const raw = JSON.parse(JSON.stringify(tc.in)); // fresh copy: in-place solutions mutate
    const args = raw.map((v, i) => hydrate(v, inTypes[i]));
    try {
      let got = fn(...args);
      // Problems that mutate an argument instead of returning ("result": "arg0")
      if (spec.result && /^arg(\d+)$/.test(spec.result)) {
        const i = parseInt(spec.result.slice(3), 10);
        got = dehydrate(args[i], inTypes[i]);
      } else {
        got = dehydrate(got, spec.outType);
      }
      const ok = matches(got, tc.out, spec.compare);
      results.push({ ok, label: callLabel(spec.fn, tc.in), actual: got, expected: tc.out });
    } catch (err) {
      results.push({ ok: false, label: callLabel(spec.fn, tc.in), error: err.message });
    }
  }
  return results;
}

/**
 * The perf case runs in a CHILD PROCESS with a hard kill timeout. A quadratic
 * solution on a 200k input would otherwise hang the terminal for minutes; this
 * way it is killed and reported as a failure against the complexity target.
 */
function runPerf(problem, spec) {
  const perfFile = path.join(TESTS, '_perf.js');
  if (!fs.existsSync(perfFile)) return null;
  const table = require(perfFile);
  const entry = table[problem.num];
  if (!entry) return null;

  const budget = entry.maxMs || 1000;
  const kill = Math.max(budget * 3, 4000);
  try {
    const raw = execFileSync(
      process.execPath,
      [path.join(TESTS, '_runperf.js'), problem.file, spec.fn || spec.cls, String(problem.num)],
      { timeout: kill, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }
    );
    const out = JSON.parse(raw.trim().split('\n').pop());
    if (out.error) return { ok: false, label: entry.label, error: out.error, budget };
    if (!out.valid) return { ok: false, label: entry.label, ms: out.ms, budget, wrong: true };
    return { ok: out.ms <= budget, label: entry.label, ms: out.ms, budget };
  } catch (err) {
    if (err.killed || err.signal) return { ok: false, label: entry.label, timeout: true, budget, kill };
    return { ok: false, label: entry.label, error: (err.stderr || err.message || '').trim().split('\n')[0], budget };
  }
}

// ---------------------------------------------------------------- report
function checkOne(problem, { quiet = false } = {}) {
  const spec = loadTest(problem.id);
  if (!spec) {
    if (!quiet) {
      console.log('');
      console.log(`  ${bold(problem.id)}  ${bold(problem.title)}   ${dim(problem.difficulty + ' · ' + problem.topic)}`);
      console.log(`  ${dim('No test cases written for this problem yet.')}`);
      console.log('');
    }
    return { state: 'no-tests' };
  }
  if (!problem.attempted) {
    if (!quiet) {
      console.log('');
      console.log(`  ${bold(problem.id)}  ${bold(problem.title)}   ${dim(problem.difficulty + ' · ' + problem.topic)}`);
      console.log('');
      console.log(`  ${yellow('Not started.')} Open ${cyan(problem.rel)} and replace the TODO,`);
      console.log(`  then run ${cyan('./practice c ' + problem.id)} again.`);
      console.log('');
    }
    return { state: 'not-started' };
  }

  const results = runCases(problem, spec);
  const perf = runPerf(problem, spec);
  const passed = results.filter((r) => r.ok).length;
  const failed = results.length - passed;
  const ok = failed === 0 && (!perf || perf.ok);

  if (!quiet) {
    console.log('');
    console.log(
      `  ${bold(problem.id)}  ${bold(problem.title)}   ${dim(problem.difficulty + ' · ' + problem.topic)}`
    );
    console.log('');
    for (const r of results) {
      if (r.ok) {
        console.log(`    ${green('✓')}  ${r.label}  ${dim('→')}  ${show(r.actual)}`);
      } else if (r.error) {
        console.log(`    ${red('✗')}  ${r.label}`);
        console.log(`         ${red('threw')}  ${r.error}`);
      } else {
        console.log(`    ${red('✗')}  ${r.label}`);
        console.log(`         ${dim('expected')}  ${show(r.expected)}`);
        console.log(`         ${dim('actual  ')}  ${red(show(r.actual))}`);
      }
    }
    if (perf) {
      const tag = `perf · ${perf.label}`;
      if (perf.ok) {
        console.log(`    ${green('✓')}  ${tag}  ${dim('→')}  ${perf.ms.toFixed(0)}ms ${dim(`(budget ${perf.budget}ms)`)}`);
      } else if (perf.timeout) {
        console.log(`    ${red('✗')}  ${tag}  ${dim('→')}  ${red('KILLED')} ${dim(`after ${perf.kill}ms (budget ${perf.budget}ms)`)}`);
        console.log(`         ${yellow('Too slow for the input size — check the Target line in the file header.')}`);
      } else if (perf.wrong) {
        console.log(`    ${red('✗')}  ${tag}  ${dim('→')}  ${red('wrong answer on the large input')}`);
      } else if (perf.error) {
        console.log(`    ${red('✗')}  ${tag}  ${dim('→')}  ${red('threw')} ${perf.error}`);
      } else {
        console.log(`    ${red('✗')}  ${tag}  ${dim('→')}  ${red(perf.ms.toFixed(0) + 'ms')} ${dim(`(budget ${perf.budget}ms)`)}`);
        console.log(`         ${yellow('Correct, but over the time budget — aim for the target complexity.')}`);
      }
    }
    console.log('');
    const verdict = ok ? green(bold('PASS')) : red(bold('FAIL'));
    const perfNote = perf ? (perf.ok ? ' · complexity target met' : ' · complexity target MISSED') : '';
    console.log(`    ${verdict}  ${passed}/${results.length} cases${perfNote}`);
  }

  return { state: ok ? 'pass' : 'fail', passed, total: results.length, perf };
}

function cmdCheck(args) {
  const all = args.includes('--all');
  const target = args.find((a) => !a.startsWith('--'));
  let problems = listProblems();

  if (target) {
    // A 3-digit argument is a problem id ("001"); anything else prefers a topic
    // folder ("01", "graphs") before falling back to an id or a slug match.
    const byId = problems.filter((p) => p.num === parseInt(target, 10));
    const byFolder = problems.filter((p) => p.folder.startsWith(target) || p.folder.includes(target));
    const bySlug = problems.filter((p) => p.rel.includes(target));
    problems = /^\d{3}$/.test(target)
      ? byId
      : byFolder.length
        ? byFolder
        : byId.length
          ? byId
          : bySlug;
    if (!problems.length) {
      console.error(red(`No problem matching "${target}".`));
      process.exit(1);
    }
  }

  const single = problems.length === 1;
  const tally = { pass: 0, fail: 0, 'not-started': 0, 'no-tests': 0 };
  const rows = [];

  for (const p of problems) {
    const res = checkOne(p, { quiet: !single });
    tally[res.state]++;
    rows.push([p, res]);
  }

  if (!single) {
    console.log('');
    for (const [p, res] of rows) {
      let status;
      if (res.state === 'pass') status = green('PASS') + dim(`  ${res.passed}/${res.total}`);
      else if (res.state === 'fail') status = red('FAIL') + dim(`  ${res.passed}/${res.total}`);
      else if (res.state === 'not-started') status = dim('—     not started');
      else status = dim('·     no tests yet');
      if (res.state === 'not-started' && !all) continue;
      if (res.state === 'no-tests' && !all) continue;
      console.log(`  ${bold(p.id)}  ${p.title.padEnd(46).slice(0, 46)}  ${status}`);
    }
    console.log('');
    const bits = [
      `${tally.pass + tally.fail} attempted`,
      tally.pass ? green(`${tally.pass} passing`) : `${tally.pass} passing`,
      tally.fail ? red(`${tally.fail} failing`) : `${tally.fail} failing`,
      dim(`${tally['not-started']} not started`),
    ];
    if (tally['no-tests']) bits.push(dim(`${tally['no-tests']} without tests`));
    console.log('  ' + bits.join(' · '));
  }

  console.log('');
  process.exit(tally.fail > 0 ? 1 : 0);
}

function cmdList(args) {
  const want = ['easy', 'medium', 'hard'].find((d) => args.includes('--' + d));
  const todo = args.includes('--todo');
  const done = args.includes('--done');
  let problems = listProblems();
  if (want) problems = problems.filter((p) => p.difficulty.toLowerCase() === want);
  if (todo) problems = problems.filter((p) => !p.attempted);
  if (done) problems = problems.filter((p) => p.attempted);

  console.log('');
  let topic = null;
  for (const p of problems) {
    if (p.topic !== topic) {
      topic = p.topic;
      console.log(`  ${bold(cyan(topic))}`);
    }
    const mark = p.attempted ? green('●') : dim('○');
    const tests = loadTest(p.id) ? '' : dim('  (no tests yet)');
    console.log(`    ${mark} ${p.id}  ${p.title.padEnd(48).slice(0, 48)} ${dim(p.difficulty)}${tests}`);
  }
  console.log('');
  console.log(`  ${problems.length} problems  ${dim('● attempted   ○ not started')}`);
  console.log('');
}

function cmdStatus() {
  const problems = listProblems();
  const withTests = problems.filter((p) => loadTest(p.id));
  const attempted = problems.filter((p) => p.attempted);
  const byDiff = {};
  for (const p of problems) {
    byDiff[p.difficulty] = byDiff[p.difficulty] || { total: 0, done: 0 };
    byDiff[p.difficulty].total++;
    if (p.attempted) byDiff[p.difficulty].done++;
  }
  console.log('');
  console.log(`  ${bold('Progress')}`);
  console.log('');
  for (const d of ['Easy', 'Medium', 'Hard']) {
    const s = byDiff[d];
    if (!s) continue;
    const width = 24;
    const filled = Math.round((s.done / s.total) * width);
    const bar = green('█'.repeat(filled)) + dim('░'.repeat(width - filled));
    console.log(`    ${d.padEnd(8)} ${bar}  ${s.done}/${s.total}`);
  }
  console.log('');
  console.log(`  ${attempted.length} of ${problems.length} attempted · ${withTests.length} problems have tests`);
  console.log('');
}

// ---------------------------------------------------------------- analytics
//
// Everything below is DERIVED from the files on disk. A problem counts as solved
// when its "// TODO: your solution here" stub is gone; it counts as verified when
// it also passes its test cases. Nothing here is hand-maintained — regenerate the
// markdown with `./practice readme`.

const POINTS = { Easy: 1, Medium: 3, Hard: 5 };

// Bands are on POINTS earned, not raw problem count, so 10 Hard problems weigh
// more than 10 Easy ones.
const LEVELS = [
  [0, 'Getting started'],
  [3, 'Beginner'],
  [12, 'Developing'],
  [30, 'Intermediate'],
  [55, 'Advanced'],
  [80, 'Expert'],
];

function bar(pct, width = 20) {
  const filled = Math.max(0, Math.min(width, Math.round((pct / 100) * width)));
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

const pctOf = (a, b) => (b ? (a / b) * 100 : 0);

function computeStats() {
  const problems = listProblems();
  const diff = {};
  const topics = new Map();
  let earned = 0;
  let possible = 0;
  let solved = 0;

  for (const p of problems) {
    const pts = POINTS[p.difficulty] || 1;
    possible += pts;
    if (p.attempted) {
      earned += pts;
      solved++;
    }
    if (!diff[p.difficulty]) diff[p.difficulty] = { total: 0, solved: 0 };
    diff[p.difficulty].total++;
    if (p.attempted) diff[p.difficulty].solved++;

    if (!topics.has(p.topic)) topics.set(p.topic, { total: 0, solved: 0, folder: p.folder });
    const t = topics.get(p.topic);
    t.total++;
    if (p.attempted) t.solved++;
  }

  const pct = pctOf(earned, possible);
  let level = LEVELS[0][1];
  for (const [min, name] of LEVELS) if (pct >= min) level = name;

  return { problems, diff, topics, earned, possible, solved, pct, level };
}

// Runs the actual test suites for solved problems that have them.
function verifyAll(problems) {
  let verified = 0;
  let failing = 0;
  let withTests = 0;
  let untested = 0;
  for (const p of problems) {
    if (!loadTest(p.id)) {
      if (p.attempted) untested++;
      continue;
    }
    withTests++;
    if (!p.attempted) continue;
    // Solutions often carry debug logging; keep it out of the analytics run.
    const saved = { log: console.log, info: console.info, warn: console.warn };
    console.log = console.info = console.warn = () => {};
    let r;
    try {
      r = checkOne(p, { quiet: true });
    } finally {
      Object.assign(console, saved);
    }
    if (r.state === 'pass') verified++;
    else if (r.state === 'fail') failing++;
  }
  return { verified, failing, withTests, untested };
}

// What to attempt next: prefer topics already in progress, then easiest first.
function suggestNext(stats, n = 5) {
  const rank = { Easy: 0, Medium: 1, Hard: 2 };
  return stats.problems
    .filter((p) => !p.attempted)
    .sort((a, b) => {
      const aStarted = stats.topics.get(a.topic).solved > 0 ? 0 : 1;
      const bStarted = stats.topics.get(b.topic).solved > 0 ? 0 : 1;
      if (aStarted !== bStarted) return aStarted - bStarted;
      if (rank[a.difficulty] !== rank[b.difficulty]) return rank[a.difficulty] - rank[b.difficulty];
      return a.num - b.num;
    })
    .slice(0, n);
}

function renderAnalytics(stats, ver) {
  const L = [];
  const overall = pctOf(stats.solved, stats.problems.length);

  L.push('### Overall');
  L.push('');
  L.push('| | |');
  L.push('|---|---|');
  L.push(`| **Solved** | ${stats.solved} of ${stats.problems.length} (${overall.toFixed(0)}%) |`);
  L.push(`| **Remaining** | ${stats.problems.length - stats.solved} |`);
  L.push(`| **Verified passing** | ${ver.verified}${ver.failing ? ` (${ver.failing} failing)` : ''} |`);
  L.push(`| **Progress** | \`${bar(overall, 28)}\` |`);
  L.push('');

  L.push('### By difficulty');
  L.push('');
  L.push('| Level | Solved | Total | Progress |');
  L.push('|-------|--------|-------|----------|');
  for (const d of ['Easy', 'Medium', 'Hard']) {
    const s = stats.diff[d];
    if (!s) continue;
    const p = pctOf(s.solved, s.total);
    L.push(`| ${d} | ${s.solved} | ${s.total} | \`${bar(p)}\` ${p.toFixed(0)}% |`);
  }
  L.push('');

  L.push('### By topic');
  L.push('');
  L.push('| Topic | Solved | Total | Progress |');
  L.push('|-------|--------|-------|----------|');
  const sorted = [...stats.topics.entries()].sort((a, b) => {
    const pa = pctOf(a[1].solved, a[1].total);
    const pb = pctOf(b[1].solved, b[1].total);
    if (pb !== pa) return pb - pa;
    return a[1].folder < b[1].folder ? -1 : 1;
  });
  for (const [topic, s] of sorted) {
    const p = pctOf(s.solved, s.total);
    L.push(`| ${topic} | ${s.solved} | ${s.total} | \`${bar(p)}\` ${p.toFixed(0)}% |`);
  }
  L.push('');

  // ---- capability read-out
  L.push('### Capability read-out');
  L.push('');
  L.push(
    `Weighted score counts Easy as ${POINTS.Easy}, Medium as ${POINTS.Medium}, Hard as ${POINTS.Hard}, ` +
      'so depth counts for more than volume.'
  );
  L.push('');
  L.push(`**${stats.earned} / ${stats.possible} points — ${stats.level}**`);
  L.push('');
  L.push(`\`${bar(stats.pct, 28)}\` ${stats.pct.toFixed(1)}%`);
  L.push('');

  const strong = sorted.filter(([, s]) => pctOf(s.solved, s.total) >= 60);
  const started = sorted.filter(([, s]) => s.solved > 0 && pctOf(s.solved, s.total) < 60);
  const untouched = sorted.filter(([, s]) => s.solved === 0);

  if (strong.length) {
    L.push(`**Strong** (60%+ solved) — ${strong.map(([t]) => t).join(', ')}`);
    L.push('');
  }
  if (started.length) {
    L.push(`**In progress** — ${started.map(([t, s]) => `${t} (${s.solved}/${s.total})`).join(', ')}`);
    L.push('');
  }
  if (untouched.length) {
    L.push(`**Not started** — ${untouched.map(([t]) => t).join(', ')}`);
    L.push('');
  }
  if (ver.untested) {
    L.push(
      `> ${ver.untested} solved problem${ver.untested === 1 ? '' : 's'} ` +
        `${ver.untested === 1 ? 'has' : 'have'} no test cases yet, so ${ver.untested === 1 ? 'it is' : 'they are'} ` +
        'counted as solved but not verified.'
    );
    L.push('');
  }

  const next = suggestNext(stats);
  if (next.length) {
    L.push('### Suggested next');
    L.push('');
    L.push('Topics already in progress first, then easiest available.');
    L.push('');
    L.push('| # | Problem | Difficulty | Topic |');
    L.push('|---|---------|------------|-------|');
    for (const p of next) {
      L.push(`| ${p.id} | [${p.title}](${p.rel}) | ${p.difficulty} | ${p.topic} |`);
    }
    L.push('');
  }

  L.push(`<sub>Generated by \`./practice readme\` — do not edit this section by hand.</sub>`);
  return L.join('\n');
}

// ---------------------------------------------------------------- generated files
function writeIndexes(stats) {
  const entries = stats.problems;

  const BLURB = {
    Easy:
      'Start here. These build the core reflexes — hash maps, two pointers, a stack, a\n' +
      'single clean pass — that every harder problem is assembled from.',
    Medium:
      'The bulk of technical interviews live here. Each one asks you to RECOGNISE a\n' +
      'pattern (sliding window, binary search on the answer, DP over subproblems,\n' +
      'topological sort) rather than invent something new.',
    Hard:
      'Multi-step problems that combine two or more patterns, or demand a non-obvious\n' +
      'insight. Do not start here — but do come back, because these are where the\n' +
      'complexity reasoning really pays off.',
  };

  for (const d of ['Easy', 'Medium', 'Hard']) {
    const sel = entries.filter((e) => e.difficulty === d);
    const done = sel.filter((e) => e.attempted).length;
    const L = [
      `# ${d} Problems`,
      '',
      `${done} of ${sel.length} solved.`,
      '',
      BLURB[d],
      '',
      '| | # | Problem | Topic |',
      '|---|---|---------|-------|',
    ];
    for (const e of sel) {
      L.push(`| ${e.attempted ? '✅' : '⬜'} | ${e.id} | [${e.title}](${e.rel}) | ${e.topic} |`);
    }
    L.push('');
    L.push('---');
    L.push('');
    L.push(
      '[All problems](PROBLEMS.md) · [README](README.md) · ' +
        ['Easy', 'Medium', 'Hard']
          .filter((x) => x !== d)
          .map((x) => `[${x}](${x.toUpperCase()}.md)`)
          .join(' · ')
    );
    L.push('');
    fs.writeFileSync(path.join(ROOT, `${d.toUpperCase()}.md`), L.join('\n'));
  }

  // Full listing, grouped by topic.
  const L = [
    '# All Problems',
    '',
    `${stats.solved} of ${entries.length} solved. ✅ means the stub has been replaced.`,
    '',
    'By difficulty: [Easy](EASY.md) · [Medium](MEDIUM.md) · [Hard](HARD.md)',
    '',
  ];
  let folder = null;
  for (const e of entries.slice().sort((a, b) => (a.folder === b.folder ? a.num - b.num : a.folder < b.folder ? -1 : 1))) {
    if (e.folder !== folder) {
      folder = e.folder;
      const t = stats.topics.get(e.topic);
      L.push('');
      L.push(`## ${e.topic}  <sub>${t.solved}/${t.total}</sub>`);
      L.push('');
      L.push('| | # | Problem | Difficulty |');
      L.push('|---|---|---------|------------|');
    }
    L.push(`| ${e.attempted ? '✅' : '⬜'} | ${e.id} | [${e.title}](${e.rel}) | ${e.difficulty} |`);
  }
  L.push('');
  fs.writeFileSync(path.join(ROOT, 'PROBLEMS.md'), L.join('\n'));
}

function cmdReadme() {
  const stats = computeStats();
  process.stdout.write('  running test suites for solved problems… ');
  const ver = verifyAll(stats.problems);
  process.stdout.write('done\n');

  const block = renderAnalytics(stats, ver);
  const readmePath = path.join(ROOT, 'README.md');
  const src = fs.readFileSync(readmePath, 'utf8');
  const START = '<!-- ANALYTICS:START -->';
  const END = '<!-- ANALYTICS:END -->';
  if (!src.includes(START) || !src.includes(END)) {
    console.error(red(`README.md is missing the ${START} / ${END} markers.`));
    process.exit(1);
  }
  const out =
    src.slice(0, src.indexOf(START) + START.length) +
    '\n\n' +
    block +
    '\n\n' +
    src.slice(src.indexOf(END));
  fs.writeFileSync(readmePath, out);
  writeIndexes(stats);

  console.log('');
  console.log(`  ${green('✓')} README.md analytics updated`);
  console.log(`  ${green('✓')} PROBLEMS.md, EASY.md, MEDIUM.md, HARD.md rebuilt`);
  console.log('');
  console.log(
    `  ${stats.solved}/${stats.problems.length} solved · ${ver.verified} verified · ${stats.earned}/${stats.possible} points · ${bold(stats.level)}`
  );
  console.log('');
}

function cmdStats() {
  const stats = computeStats();
  const ver = verifyAll(stats.problems);
  const overall = pctOf(stats.solved, stats.problems.length);

  console.log('');
  console.log(`  ${bold('Progress')}   ${stats.solved}/${stats.problems.length} solved ${dim(`(${overall.toFixed(0)}%)`)}`);
  console.log('');
  for (const d of ['Easy', 'Medium', 'Hard']) {
    const s = stats.diff[d];
    if (!s) continue;
    const p = pctOf(s.solved, s.total);
    console.log(`    ${d.padEnd(8)} ${green(bar(p, 24).slice(0, Math.round((p / 100) * 24)))}${dim('░'.repeat(24 - Math.round((p / 100) * 24)))}  ${s.solved}/${s.total}`);
  }
  console.log('');
  console.log(`  ${bold('By topic')}`);
  console.log('');
  const sorted = [...stats.topics.entries()].sort((a, b) => pctOf(b[1].solved, b[1].total) - pctOf(a[1].solved, a[1].total));
  for (const [topic, s] of sorted) {
    const p = pctOf(s.solved, s.total);
    const filled = Math.round((p / 100) * 16);
    console.log(`    ${topic.padEnd(24).slice(0, 24)} ${green('█'.repeat(filled))}${dim('░'.repeat(16 - filled))}  ${String(s.solved).padStart(2)}/${s.total}`);
  }
  console.log('');
  console.log(`  ${bold('Score')}  ${stats.earned}/${stats.possible} points ${dim('(Easy 1 · Medium 3 · Hard 5)')}  →  ${bold(green(stats.level))}`);
  console.log(`  ${bold('Tests')}  ${ver.verified} verified passing${ver.failing ? red(` · ${ver.failing} failing`) : ''}${ver.untested ? dim(` · ${ver.untested} solved without tests`) : ''}`);
  console.log('');
  const next = suggestNext(stats, 3);
  if (next.length) {
    console.log(`  ${bold('Suggested next')}`);
    for (const p of next) console.log(`    ${p.id}  ${p.title.padEnd(44).slice(0, 44)} ${dim(p.difficulty + ' · ' + p.topic)}`);
    console.log('');
  }
}

