const [cmd, ...rest] = process.argv.slice(2);
if (cmd === 'c' || cmd === 'check') cmdCheck(rest);
else if (cmd === 'list') cmdList(rest);
else if (cmd === 'status') cmdStatus();
else if (cmd === 'stats') cmdStats();
else if (cmd === 'readme') cmdReadme();
else usage();
